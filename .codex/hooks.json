{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/cost-aware-approval/hooks/pretooluse-codex.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Agent_skill/hooks/stop-handoff-check.sh"
          }
        ]
      }
    ]
  }
}
